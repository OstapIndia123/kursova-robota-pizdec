digraph CourseworkClasses {
  graph [rankdir=TB, bgcolor="white", pad=0.12, nodesep=0.18, ranksep=0.32, fontname="Liberation Serif"];
  node [shape=record, style="rounded,filled", fillcolor="#f7f9fc", color="#334155", fontname="Liberation Serif", fontsize=16, margin="0.08,0.05"];
  edge [color="#475569", fontname="Liberation Serif", fontsize=12, arrowsize=0.8];
  Shape3D [label="{«абстрактний клас» Shape3D|+ volume() : double — pure virtual\l+ surfaceArea() : double — pure virtual\l+ typeName() : string — pure virtual\l+ ratio() : double\l+ virtual ~Shape3D()\l}"];
  Cone [label="{Cone|− radius_ : double\l− height_ : double\l|+ Cone(radius, height)\l+ volume() : double override\l+ surfaceArea() : double override\l+ typeName() : string override\l}"];
  Cylinder [label="{Cylinder|− radius_ : double\l− height_ : double\l|+ Cylinder(radius, height)\l+ volume() : double override\l+ surfaceArea() : double override\l+ typeName() : string override\l}"];
  Tetrahedron [label="{Tetrahedron|− a_, b_, c_, d_ : Vector3D\l|+ Tetrahedron(a, b, c, d)\l+ volume() : double override\l+ surfaceArea() : double override\l+ typeName() : string override\l}"];
  Vector3D [label="{Vector3D|+ x, y, z : double\l|+ operator−(Vector3D) : Vector3D\l+ operator/(double) : Vector3D\l+ cross(Vector3D) : Vector3D\l+ dot(Vector3D) : double\l+ norm() : double\l+ isFinite() : bool\l}"];
  ShapeFactory [label="{ShapeFactory|+ static create(type, parameters) : unique_ptr<Shape3D>\l}"];
  FileProcessor [label="{FileProcessor|+ process(inputPath) const : vector<RecordResult>\l}"];
  RecordResult [label="{RecordResult|+ lineNumber : size_t\l+ shape : string\l+ object : unique_ptr<Shape3D>\l+ error : string\l}"];
  ResultWriter [label="{ResultWriter|+ static write(results, console, outputPath, inputPath)\l}"];
  {rank=same; ShapeFactory; FileProcessor; ResultWriter}
  Cone -> Shape3D [arrowhead=empty]; Cylinder -> Shape3D [arrowhead=empty]; Tetrahedron -> Shape3D [arrowhead=empty];
  Tetrahedron -> Vector3D [arrowhead=vee, label="4 значення"];
  ShapeFactory -> Shape3D [style=dashed, label="створює"];
  FileProcessor -> ShapeFactory [style=dashed, label="викликає"];
  FileProcessor -> RecordResult [arrowhead=vee, label="повертає vector"];
  RecordResult -> Shape3D [arrowhead=vee, label="unique_ptr"];
  ResultWriter -> RecordResult [style=dashed, label="форматує"];
}
